# ============================================================================
# BLADE 설정 — cp .env.example .env 후 값 채우기
# 비밀값(시크릿·API 키·웹훅)은 커밋/화면 노출 금지
# ============================================================================

# --- 꼭 필요한 값 ----------------------------------------------------------

# 호출자 JWT 서명 검증에 쓰는 HMAC 시크릿. 토큰 발급 측과 같은 값이어야 함(32바이트 이상 권장).
BLADE_JWT_SECRET=change-me-to-a-long-random-string

# BLADE가 앞에 붙어 보호할 "내 API"의 주소(업스트림).
BLADE_TARGET_URL=http://127.0.0.1:9000

# 소유자/테넌트 조회용 "내 DB"의 읽기 전용 DSN(owner_match·tenant_match·owner_or_admin에 필요).
BLADE_DB_DSN=sqlite:///demo.db

# --- 분류기: 정책을 어떻게 만들까 (llm 기본 / lora) --------------------------
BLADE_CLASSIFIER=llm

#   (A) llm 경로
BLADE_LLM_PROVIDER=openai          # openai | anthropic | ollama
BLADE_LLM_MODEL=gpt-4o-mini        # 제공자별 모델 이름
# OPENAI_API_KEY=sk-...            # provider=openai 일 때
# ANTHROPIC_API_KEY=sk-ant-...     # provider=anthropic 일 때

#   (B) lora 경로 (로컬 Ollama + 우리 LoRA 어댑터)
# BLADE_CLASSIFIER=lora
# BLADE_LORA_MODEL=blade-qwen-lora-v7   # Ollama에 등록한 모델 이름
# BLADE_OLLAMA_URL=http://127.0.0.1:11434
# BLADE_LORA_MIN_CONFIDENCE=0.9         # 이 미만이면 manual_review로 보류

# --- 런타임 동작 (기본값이면 생략 가능) -------------------------------------
# 정책/평가 불가 시 동작: open=통과, closed=차단. 운영은 closed 권장.
BLADE_FAIL_MODE=open

# admin API 주소
BLADE_ADMIN_URL=http://127.0.0.1:8100

# 프록시 바인드 호스트(외부 노출 시 0.0.0.0). 포트는 8080 고정.
BLADE_PROXY_HOST=127.0.0.1

# 정책 캐시 TTL(초) / 정책 갱신 폴링 주기(초)
BLADE_CACHE_TTL=60
BLADE_POLICY_POLL_SEC=5

# --- 알림 (선택) -----------------------------------------------------------
# BLADE_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# BLADE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# --- 선택 기능 플래그 (true 로 켜기) ----------------------------------------
# BLADE_OBSERVABILITY_ENABLED=true   # 지표 집계
# BLADE_MODE_ENABLED=true            # enforce/observe 모드 전환
# BLADE_ALERTS_ENABLED=true          # 대시보드 알림 설정 탭
# BLADE_EXPLAIN_ENABLED=true         # 탐지 설명
# BLADE_RAG_ENABLED=true             # 근거 검색(무거운 선택 의존성 rag)
# 전체 목록은 docs/configuration.md
